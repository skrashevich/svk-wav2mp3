FROM golang:1.26

# Install build tools
RUN apt-get update && apt-get install -y build-essential

# Install ccgo
RUN go install modernc.org/ccgo/v4@latest

# Download LAME source
RUN apt-get update && apt-get install -y wget && \
    cd /src && \
    wget https://sourceforge.net/projects/lame/files/lame/3.100/lame-3.100.tar.gz && \
    tar xzf lame-3.100.tar.gz && \
    rm lame-3.100.tar.gz

# Configure LAME to generate config.h (Linux target)
WORKDIR /src/lame-3.100
RUN ./configure --disable-shared --disable-frontend --disable-decoder \
    --disable-gtktest --enable-static \
    --disable-rpath --disable-cpml \
    CFLAGS="-O2 -fno-strict-aliasing"

# Create output module
RUN mkdir -p /output && cd /output && \
    go mod init lamelib && \
    go get modernc.org/libc@latest

WORKDIR /output

# Common ccgo flags
ENV CCGO_FLAGS="--package-name lamelib -DHAVE_CONFIG_H -I/src/lame-3.100/include -I/src/lame-3.100/libmp3lame -I/src/lame-3.100 -DNOANALYSIS -DLAME_LIBRARY_BUILD -DSTDC_HEADERS -DHAVE_STDINT_H -ignore-asm-errors -ignore-unsupported-alignment"
ENV LAME_SRCS="/src/lame-3.100/libmp3lame/VbrTag.c /src/lame-3.100/libmp3lame/bitstream.c /src/lame-3.100/libmp3lame/encoder.c /src/lame-3.100/libmp3lame/fft.c /src/lame-3.100/libmp3lame/gain_analysis.c /src/lame-3.100/libmp3lame/id3tag.c /src/lame-3.100/libmp3lame/lame.c /src/lame-3.100/libmp3lame/mpglib_interface.c /src/lame-3.100/libmp3lame/newmdct.c /src/lame-3.100/libmp3lame/presets.c /src/lame-3.100/libmp3lame/psymodel.c /src/lame-3.100/libmp3lame/quantize.c /src/lame-3.100/libmp3lame/quantize_pvt.c /src/lame-3.100/libmp3lame/reservoir.c /src/lame-3.100/libmp3lame/set_get.c /src/lame-3.100/libmp3lame/tables.c /src/lame-3.100/libmp3lame/takehiro.c /src/lame-3.100/libmp3lame/util.c /src/lame-3.100/libmp3lame/vbrquantize.c /src/lame-3.100/libmp3lame/version.c"

# Generate for linux/arm64
RUN CCGO=$(go env GOPATH)/bin/ccgo && \
    TARGET_GOOS=linux TARGET_GOARCH=arm64 \
    $CCGO $CCGO_FLAGS -o lame_linux_arm64.go $LAME_SRCS 2>&1 && \
    echo "linux/arm64 OK" || echo "linux/arm64 FAILED"

# Generate for linux/amd64
RUN CCGO=$(go env GOPATH)/bin/ccgo && \
    TARGET_GOOS=linux TARGET_GOARCH=amd64 \
    $CCGO $CCGO_FLAGS -o lame_linux_amd64.go $LAME_SRCS 2>&1 && \
    echo "linux/amd64 OK" || echo "linux/amd64 FAILED"

# Generate for darwin/arm64
RUN CCGO=$(go env GOPATH)/bin/ccgo && \
    TARGET_GOOS=darwin TARGET_GOARCH=arm64 \
    $CCGO $CCGO_FLAGS -o lame_darwin_arm64.go $LAME_SRCS 2>&1 && \
    echo "darwin/arm64 OK" || echo "darwin/arm64 FAILED"

# Generate for darwin/amd64
RUN CCGO=$(go env GOPATH)/bin/ccgo && \
    TARGET_GOOS=darwin TARGET_GOARCH=amd64 \
    $CCGO $CCGO_FLAGS -o lame_darwin_amd64.go $LAME_SRCS 2>&1 && \
    echo "darwin/amd64 OK" || echo "darwin/amd64 FAILED"

# List output
RUN ls -la /output/*.go && echo "---" && wc -l /output/*.go

CMD ["sh", "-c", "ls /output/*.go"]
